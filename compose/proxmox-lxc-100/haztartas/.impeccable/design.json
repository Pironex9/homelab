  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ink submit button on forms.",
      "html": "<button class=\"ds-btn\">Belépés</button>",
      "css": ".ds-btn{min-height:52px;padding:0 24px;border:0;border-radius:12px;background:var(--ink,#1c1b19);color:var(--ground,#f3f1ec);font:700 1rem system-ui,sans-serif;cursor:pointer}.ds-btn:hover{background:#33312d}.ds-btn:focus-visible{outline:3px solid #2b5bd7;outline-offset:2px}"
    },
    {
      "name": "Capture Row",
      "kind": "custom",
      "refersTo": "button-capture-primary",
      "description": "Bottom dock: two disabled captures and the live Kézi button.",
      "html": "<div class=\"ds-dock\"><span class=\"ds-cap off\">Fotó<small>hamarosan</small></span><span class=\"ds-cap off\">Hang<small>hamarosan</small></span><a class=\"ds-cap pri\" href=\"#\">Kézi</a></div>",
      "css": ".ds-dock{display:grid;grid-template-columns:1fr 1fr 1.6fr;gap:8px;font-family:system-ui,sans-serif}.ds-cap{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;min-height:60px;border-radius:12px;background:#e7e3da;color:#1c1b19;font:600 .875rem system-ui,sans-serif;text-decoration:none}.ds-cap small{font-size:.6875rem;font-weight:500;color:#5f5b53}.ds-cap.off{color:#8a857a}.ds-cap.pri{background:#1c1b19;color:#f3f1ec;font-size:1rem}.ds-cap.pri:hover{background:#33312d}.ds-cap.pri:focus-visible{outline:3px solid #2b5bd7;outline-offset:2px}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input-field",
      "description": "White field with hairline border and ink focus.",
      "html": "<input class=\"ds-input\" value=\"Felhasználó\">",
      "css": ".ds-input{width:100%;min-height:48px;padding:0 12px;border:1.5px solid #d6d1c6;border-radius:12px;background:#fff;font:inherit;color:#1c1b19;box-sizing:border-box}.ds-input:focus{border-color:#1c1b19;outline:none;box-shadow:0 0 0 3px rgb(43 91 215 / .25)}"
    },
    {
      "name": "Error Note",
      "kind": "custom",
      "refersTo": "error-note",
      "description": "Form error only.",
      "html": "<p class=\"ds-err\" role=\"alert\">Hibás jelszó.</p>",
      "css": ".ds-err{margin:0;padding:12px;border-radius:12px;background:#f6e3df;color:#a3271c;font:.875rem system-ui,sans-serif}"
    },
    {
      "name": "Category Tile",
      "kind": "card",
      "refersTo": "tile",
      "description": "Map tile with amount, limit and limit rail.",
      "html": "<a class=\"ds-tile\"><span class=\"n\">Élelmiszer</span><span><span class=\"a\">412 €</span><span class=\"l\">500 € keretből</span></span><span class=\"rail\"><i></i></span></a>",
      "css": ".ds-tile{position:relative;display:flex;flex-direction:column;justify-content:space-between;width:180px;height:140px;padding:8px 12px 12px;box-sizing:border-box;border-radius:10px;overflow:hidden;background:var(--tile-0,#2e6b4f);color:#fff;text-decoration:none;font-family:system-ui,sans-serif;font-variant-numeric:tabular-nums;transition:transform 160ms cubic-bezier(.16,1,.3,1)}.ds-tile:active{transform:scale(.98)}.ds-tile:focus-visible{outline:3px solid #2b5bd7;outline-offset:2px}.ds-tile .n{font-size:.875rem;font-weight:600}.ds-tile .a{display:block;font-size:1.25rem;font-weight:800;letter-spacing:-.01em}.ds-tile .l{display:block;font-size:.75rem;font-weight:500;opacity:.9}.ds-tile .rail{position:absolute;left:0;right:0;bottom:0;height:6px;background:rgb(0 0 0 / .28)}.ds-tile .rail i{display:block;height:100%;width:82%;background:#fff}"
    },
    {
      "name": "Over-limit Rail",
      "kind": "custom",
      "refersTo": "tile",
      "description": "The over-limit signal: hatched rail plus bold text.",
      "html": "<a class=\"ds-tile over\"><span class=\"n\">Szórakozás</span><span><span class=\"a\">130 €</span><span class=\"l\">+30 € felett</span></span><span class=\"rail\"><i></i></span></a>",
      "css": ".ds-tile{position:relative;display:flex;flex-direction:column;justify-content:space-between;width:180px;height:140px;padding:8px 12px 12px;box-sizing:border-box;border-radius:10px;overflow:hidden;background:var(--tile-2,#3c5a9a);color:#fff;font-family:system-ui,sans-serif}.ds-tile .n{font-size:.875rem;font-weight:600}.ds-tile .a{display:block;font-size:1.25rem;font-weight:800}.ds-tile .l{display:block;font-size:.75rem;font-weight:700}.ds-tile .rail{position:absolute;left:0;right:0;bottom:0;height:6px;background:rgb(0 0 0 / .28)}.ds-tile .rail i{display:block;height:100%;width:100%;background:repeating-linear-gradient(-45deg,#fff 0 4px,transparent 4px 7px)}"
    },
    {
      "name": "Month Stepper",
      "kind": "nav",
      "refersTo": "icon-button",
      "description": "Round 48px arrows around the month label.",
      "html": "<nav class=\"ds-step\"><a href=\"#\" aria-label=\"Előző\"><svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m15 18-6-6 6-6\"/></svg></a><span>2026. november</span><a href=\"#\" aria-label=\"Következő\"><svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m9 18 6-6-6-6\"/></svg></a></nav>",
      "css": ".ds-step{display:flex;align-items:center;gap:4px;font:600 .875rem system-ui,sans-serif;color:#1c1b19}.ds-step a{display:grid;place-items:center;width:48px;height:48px;border-radius:50%;color:inherit;text-decoration:none}.ds-step a:hover{background:#e7e3da}.ds-step a:focus-visible{outline:3px solid #2b5bd7;outline-offset:2px}"
    },
    {
      "name": "Sub-page Header",
      "kind": "nav",
      "refersTo": "icon-button",
      "description": "Back icon, bold page title, optional month stepper; replaces the home top bar on sub-pages.",
      "html": "<header class=\"ds-sub\"><a class=\"ds-back\" href=\"#\" aria-label=\"Vissza\"><svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m15 18-6-6 6-6\"/></svg></a><h1>Tételek</h1></header>",
      "css": ".ds-sub{display:flex;align-items:center;gap:8px;padding:12px 16px 8px;font-family:system-ui,sans-serif;color:#1c1b19}.ds-sub h1{margin:0 auto 0 0;font-size:1.25rem;font-weight:800;letter-spacing:-.01em}.ds-back{display:grid;place-items:center;width:48px;height:48px;margin-left:-12px;border-radius:50%;color:inherit;text-decoration:none}.ds-back:hover{background:#e7e3da}.ds-back:focus-visible{outline:3px solid #2b5bd7;outline-offset:2px}"
    },
    {
      "name": "Quiet Button",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Hairline-outlined secondary action beside or under the ink button.",
      "html": "<button class=\"ds-quiet\">Archiválás</button>",
      "css": ".ds-quiet{width:100%;min-height:52px;border:1.5px solid #d6d1c6;border-radius:12px;background:transparent;color:#1c1b19;font:700 1rem system-ui,sans-serif;cursor:pointer}.ds-quiet:hover{background:#e7e3da}.ds-quiet:focus-visible{outline:3px solid #2b5bd7;outline-offset:2px}"
    },
    {
      "name": "Amount Field",
      "kind": "input",
      "refersTo": "input-amount",
      "description": "Large tabular amount input beside a narrow currency select.",
      "html": "<div class=\"ds-amt\"><div><label for=\"a\">Összeg</label><input id=\"a\" value=\"12,50\"></div><div><label for=\"c\">Pénznem</label><select id=\"c\"><option>EUR</option></select></div></div>",
      "css": ".ds-amt{display:grid;grid-template-columns:1fr 104px;gap:8px;align-items:end;font-family:system-ui,sans-serif;color:#1c1b19}.ds-amt label{display:block;margin-bottom:8px;font-size:.875rem;font-weight:600}.ds-amt input,.ds-amt select{width:100%;min-height:48px;padding:0 12px;border:1.5px solid #d6d1c6;border-radius:12px;background:#fff;font:inherit;color:#1c1b19;box-sizing:border-box}.ds-amt input{min-height:64px;font-size:2rem;font-weight:800;letter-spacing:-.02em;font-variant-numeric:tabular-nums}.ds-amt input:focus{border-color:#1c1b19;outline:none;box-shadow:0 0 0 3px rgb(43 91 215 / .25)}"
    },
    {
      "name": "Segmented Choice",
      "kind": "custom",
      "refersTo": "seg-option",
      "description": "Joined strip of exclusive options; selected fills ink.",
      "html": "<fieldset class=\"ds-seg\"><legend>Fizetés</legend><label><input type=\"radio\" name=\"p\" checked><span>Kártya</span></label><label><input type=\"radio\" name=\"p\"><span>Készpénz</span></label><label><input type=\"radio\" name=\"p\"><span>Egyéb</span></label></fieldset>",
      "css": ".ds-seg{display:flex;margin:0;padding:0;border:0;font-family:system-ui,sans-serif;color:#1c1b19}.ds-seg legend{padding:0;margin-bottom:8px;font-size:.875rem;font-weight:600}.ds-seg label{position:relative;flex:1}.ds-seg input{position:absolute;inset:0;width:100%;height:100%;margin:0;opacity:0;pointer-events:none}.ds-seg span{display:grid;place-items:center;min-height:48px;border:1.5px solid #d6d1c6;background:#fff;font-size:.875rem;font-weight:600;cursor:pointer}.ds-seg label:first-of-type span{border-radius:12px 0 0 12px}.ds-seg label:last-of-type span{border-radius:0 12px 12px 0}.ds-seg label+label span{border-left-width:0}.ds-seg input:checked+span{background:#1c1b19;border-color:#1c1b19;color:#f3f1ec}.ds-seg input:focus-visible+span{outline:3px solid #2b5bd7;outline-offset:2px}"
    },
    {
      "name": "Hidden-entry Block",
      "kind": "custom",
      "refersTo": "secret-block",
      "description": "Second-stone panel with a switch and a hint; the switch reveals the reveal-date field.",
      "html": "<div class=\"ds-secret\"><label class=\"ds-switch\"><input type=\"checkbox\" checked><span>Rejtett tétel</span></label><p>Csak te látod, amíg fel nem fedjük.</p></div>",
      "css": ".ds-secret{display:grid;gap:8px;padding:12px;border-radius:12px;background:#e7e3da;font-family:system-ui,sans-serif;color:#1c1b19}.ds-secret p{margin:0;font-size:.75rem;color:#5f5b53}.ds-switch{display:flex;align-items:center;gap:12px;min-height:48px;cursor:pointer;font-size:.875rem;font-weight:600}.ds-switch input{appearance:none;flex:none;width:44px;height:26px;margin:0;border:0;border-radius:13px;background:#8a857a;position:relative;cursor:pointer;transition:background 160ms cubic-bezier(.16,1,.3,1)}.ds-switch input::after{content:\"\";position:absolute;top:3px;left:3px;width:20px;height:20px;border-radius:50%;background:#fff;transition:transform 160ms cubic-bezier(.16,1,.3,1)}.ds-switch input:checked{background:#1c1b19}.ds-switch input:checked::after{transform:translateX(18px)}.ds-switch input:focus-visible{outline:3px solid #2b5bd7;outline-offset:2px}"
    },
    {
      "name": "Duplicate Prompt",
      "kind": "custom",
      "refersTo": "duplicate-prompt",
      "description": "Replaces the submit button when a similar entry exists; informs and asks, not red.",
      "html": "<section class=\"ds-dup\" role=\"alert\"><p class=\"t\">Hasonló tétel már van</p><ul><li>Lidl · <span>12,50 €</span> · Anna</li></ul><button class=\"ds-ink\">Mentés mégis</button><a class=\"ds-q\" href=\"#\">Mégse</a></section>",
      "css": ".ds-dup{padding:16px;border-radius:12px;background:#e7e3da;font-family:system-ui,sans-serif;color:#1c1b19}.ds-dup .t{margin:0 0 8px;font-weight:700}.ds-dup ul{margin:0 0 8px;padding-left:16px;font-size:.875rem;font-variant-numeric:tabular-nums}.ds-ink{width:100%;min-height:52px;margin-top:16px;border:0;border-radius:12px;background:#1c1b19;color:#f3f1ec;font:700 1rem system-ui,sans-serif;cursor:pointer}.ds-ink:hover{background:#33312d}.ds-q{display:grid;place-items:center;min-height:52px;margin-top:8px;border:1.5px solid #d6d1c6;border-radius:12px;color:#1c1b19;text-decoration:none;font-weight:700}.ds-q:hover{background:#d6d1c6}"
    },
    {
      "name": "Expandable Row",
      "kind": "custom",
      "refersTo": "expandable-row",
      "description": "Hairline row with a 56px summary (dot, name, value); opens to a form.",
