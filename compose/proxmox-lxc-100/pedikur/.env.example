TZ=Europe/Bratislava
DOCKER_DATA=/srv/docker-data
# Both secrets live in the Komodo Stack Environment, never in git.
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
PEDIKUR_SECRET_KEY=
PEDIKUR_API_TOKEN=
# Set to 0 only to reach the app over plain http (LAN, screenshot loop).
# The public route through Pangolin is https, so it stays 1 there.
PEDIKUR_HTTPS_ONLY=1
