:80 {
	# The heartbeat payload is large and highly repetitive: 242 KB for 37
	# monitors, and still around 85 KB for the curated 13. It compresses
	# 13x (measured: 242 KB -> 18 KB gzipped), so this one line is the
	# fix rather than trying to shrink the payload at the Kuma end.
	# Kuma's showOnlyLastHeartbeat option does NOT help - the heartbeat
	# route hardcodes `LIMIT 100` and never reads that flag.
	encode zstd gzip

	# Uptime Kuma runs on this same host with network_mode: host.
	# 172.17.0.1 is the address Pangolin's own resource target uses; the
	# architecture diagram in docs/vps/03 says 172.18.0.1 and is wrong.
	# Only these two prefixes are proxied, not all of Kuma's API.
	# Badges stay a wildcard because the monitor ids follow whatever Task 1
	# curates, and Kuma gates them itself: isMonitorPublic() makes a badge
	# for a non-public monitor render "N/A" rather than leak a figure.
	handle /api/badge/* {
		reverse_proxy 172.17.0.1:3001
	}

	# Status-page routes are pinned to this one slug, NOT /api/status-page/*.
	# A wildcard would publish every status page Kuma ever hosts through the
	# apex, including a future one created for private use. This route is on
	# an auth-free public hostname, so it grants exactly what the widget
	# needs and nothing else.
	#
	# COUPLED to src/status.js: the slug below must match the SLUG constant
	# there. Nothing enforces it. Change it in only one file and both fetches
	# 404, the uptime block stays hidden for good, and the only trace is a
	# console.warn in the visitor's browser. Change both.
	handle /api/status-page/statuspage1 {
		reverse_proxy 172.17.0.1:3001
	}

	handle /api/status-page/heartbeat/statuspage1 {
		reverse_proxy 172.17.0.1:3001
	}

	# Umami tracker, first-party on purpose. The dashboard itself stays on the
	# tailnet (https://umami.tailc6abe2.ts.net) and is NOT published here -
	# these two paths are the whole public surface, and anything not listed
	# falls through to the static site below and 404s.
	#
	# WHY THROUGH THIS CADDY AND NOT A PANGOLIN RESOURCE: a separate
	# umami.homelabor.net would have to serve the login page publicly, and
	# restricting it would depend on Pangolin path rules, which mean "bypass
	# auth" rather than "permit" and are known to misfire on protected
	# resources (fosrl/pangolin#2551). Here the allow-list is the route table.
	#
	# The second reason is the CSP in the handle block at the end of this file:
	# `script-src 'self'` and `connect-src 'self'`. Same-origin means the
	# tracker needs no exception at all - a subdomain would have forced two.
	#
	# The tracker derives its collect endpoint from its own script URL
	# (src/tracker/index.ts: currentScript.src minus the filename), so
	# docs.homelabor.net loading https://homelabor.net/script.js posts back to
	# https://homelabor.net/api/send on its own. Umami answers /api/* with
	# `Access-Control-Allow-Origin: *`, which is what makes the cross-origin
	# case work from GitHub Pages.
	handle /script.js {
		reverse_proxy https://umami.tailc6abe2.ts.net {
			header_up Host umami.tailc6abe2.ts.net
		}
	}

	# POST only in practice, plus the CORS preflight from docs.homelabor.net.
	# Caddy appends this hop to the X-Forwarded-For that Traefik already set,
	# so the leftmost address stays the real visitor - which is the one
	# Umami reads (src/lib/ip.ts).
	handle /api/send {
		reverse_proxy https://umami.tailc6abe2.ts.net {
			header_up Host umami.tailc6abe2.ts.net
		}
	}

	# Applies to every response, including the proxied Kuma routes above.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# The interactive topology map at /topology/ is a build artifact copied in
	# from compose/proxmox-lxc-100/topology/. It carries an inline <style>, an
	# inline <script> and inline style attributes, so it still gets its own,
	# weaker policy rather than dragging the landing page down to its level.
	#
	# It no longer fetches anything from a third party. Its two faces are
	# base64 data: URIs embedded by that stack's build.js, which is why
	# font-src is data: and why style-src no longer names Google. If a future
	# build goes back to linking a font, this policy blocks it - deliberately.
	handle /topology/* {
		header Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'self' 'unsafe-inline'; font-src data:; script-src 'self' 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		root * /usr/share/caddy
		file_server
	}

	handle {
		# Strict, and it can afford to be: the landing page loads no inline
		# script, no inline style, no external font and no third-party asset
		# of any kind. connect-src is for status.js reaching the two Kuma
		# routes above, which are same-origin by design.
		#
		# COUPLED to src/index.html: putting a <script> or a style attribute
		# back into that file breaks it silently in the browser and nowhere
		# else. src/ui.js exists precisely so that stays true.
		header Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"

		# Fonts and the favicon are the only assets that get the long cache.
		# They change only on a deliberate re-subset or a mark redraw, and
		# without a rule they would ship with no Cache-Control at all - the
		# failure the comment below describes.
		#
		# The diagram used to sit here too, and that was wrong. max-age means
		# the browser does not ask the server at all for the whole window, so
		# an Etag cannot save it; stale-while-revalidate then permits one more
		# stale render after the window expires. A topology change was
		# therefore invisible to a returning visitor for 24 hours guaranteed,
		# plus one more page load any time inside 8 days. Measured on
		# 2026-08-23, moving *.png and *.webp to the revalidate rule below
		# costs 33 ms and zero bytes per visit on a warm connection (304, no
		# body) against 84 KB for the WebP. The map is the most visible thing
		# on the page and it only ever moves because the homelab moved.
		@longlived path *.woff2 *.svg
		header @longlived Cache-Control "public, max-age=86400, stale-while-revalidate=604800"

		# no-cache means "keep a copy, but ask before using it" - not "do not
		# cache". Without it these files carry no Cache-Control at all, and a
		# browser then invents a freshness window from the Last-Modified date:
		# roughly a tenth of the file's age, so an index.html that had sat
		# unchanged for nine days was treated as fresh for most of a day and
		# the deploy simply did not arrive. An Etag does not help there,
		# because the browser never asks. It costs one 304 per visit.
		@revalidate path / *.html *.css *.js *.png *.webp
		header @revalidate Cache-Control "no-cache"

		root * /usr/share/caddy
		file_server
	}
}
