# Copy to scripts/.env and fill in. scripts/.env is gitignored, never commit it.
# Used by backup.sh and restore-test.sh.

# --- restic ---
BACKUP_DEST_NFS=/mnt/backup                 # one restic repo per service underneath
BACKUP_DEST_CLOUD=b2:your-bucket-name
RESTIC_PASSWORD=your_restic_encryption_password_here
# RESTIC_PASSWORD_FILE=/root/.restic-password   # alternative to RESTIC_PASSWORD

# --- ntfy ---
NTFY_URL=https://ntfy.lan/homelab-backup    # backup.sh posts here (full URL with topic)
NTFY_BASE_URL=https://ntfy.lan              # restore-test.sh appends NTFY_TOPIC
NTFY_TOPIC=homelab-digest
# Extra curl options for hosts that do not resolve ntfy.lan through AdGuard,
# same trick as homelab-digest.sh:
# NTFY_CURL_OPTS="--resolve ntfy.lan:443:192.168.0.208 -k"

# --- restore-test.sh ---
RESTORE_TEST_MAX_AGE_DAYS=2                 # fail if the newest snapshot is older
RESTORE_TEST_FILES=3                        # files restored and checksummed per repo
RESTORE_TEST_SUBSET=1%                      # restic check --read-data-subset
RESTORE_TEST_LOG=/var/log/homelab/restore-test.log
RESTORE_TEST_TMPDIR=/tmp                    # restores land in a mktemp dir here
