# Copy to scripts/.env and fill in. scripts/.env is gitignored, never commit it.
# Used by restore-test.sh.
#
# Where it actually runs today (2026-08-12):
#   restore-test.sh -> pve (192.168.0.109), against the one live restic repo
#                      /mnt/disk1/backup/proxmox-host, written weekly by
#                      /root/backup-proxmox-restic.sh (cron, Sunday 04:00).
# The values below are the pve ones, so restore-test.sh works as written there.
# See scripts/README.md for the four backup layers that actually run; none of
# them is driven from this directory.

# --- restic ---
# One restic repo per subdirectory. On pve this holds a single repo,
# proxmox-host; the sibling "proxmox" directory is vzdump output and is skipped
# because it has no restic config/data/snapshots layout.
# Despite the name this is a local disk on pve, not an NFS mount.
BACKUP_DEST_NFS=/mnt/disk1/backup
RESTIC_PASSWORD_FILE=/root/.secrets/restic-password
# RESTIC_PASSWORD=...                         # alternative to the password file

# --- ntfy ---
# Plain HTTP against the LAN IP on purpose: ntfy.lan behind Caddy rejects real
# TLS clients (see private/todo.md point 7), so https://ntfy.lan would fail here.
NTFY_BASE_URL=http://192.168.0.71:8091
NTFY_TOPIC=homelab-digest
# NTFY_URL=...                                # legacy, full URL with topic baked in
# NTFY_CURL_OPTS="--resolve ntfy.lan:443:192.168.0.208 -k"   # if ntfy.lan is used

# --- restore-test.sh ---
# 8 days, because the pve backup is weekly. A shorter limit fails every run.
RESTORE_TEST_MAX_AGE_DAYS=8
RESTORE_TEST_FILES=3                        # files restored and checksummed per repo
RESTORE_TEST_SUBSET=1%                      # restic check --read-data-subset
RESTORE_TEST_LOG=/var/log/homelab/restore-test.log
# Restores land in a mktemp dir here. Not /tmp on pve: that is tmpfs, so the
# restored files would eat RAM the guests are using.
RESTORE_TEST_TMPDIR=/var/tmp
